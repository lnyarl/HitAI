{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HitAI",
  "version": "0.1.0",
  "identifier": "app.hitai.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run sidecar",
    "beforeBuildCommand": "npm run sidecar:release"
  },
  "app": {
    "windows": [
      {
        "title": "HitAI",
        "width": 440,
        "height": 760,
        "minWidth": 380,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://tauri.localhost; script-src 'self' tauri: http://tauri.localhost; style-src 'self' tauri: http://tauri.localhost 'unsafe-inline'; img-src 'self' tauri: http://tauri.localhost data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/hitai-hook"
    ]
  },
  "mainBinaryName": "hitai-desktop"
}
